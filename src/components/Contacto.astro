---
import { site, whatsappUrl } from '../config/site';
---

<section id="contacto" class="py-5 bg-brand-soft">
  <div class="container py-4 text-center">
    <h2 class="fw-bold mb-3">¿Tenés un evento en camino?</h2>
    <p class="text-secondary mx-auto mb-4" style="max-width: 36rem">
      Escribinos con la fecha y la cantidad de invitados y te pasamos presupuesto sin compromiso.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-3 mb-5">
      <a class="btn btn-whatsapp btn-lg" href={whatsappUrl} target="_blank" rel="noopener">
        <i class="bi bi-whatsapp me-2"></i>Escribir por WhatsApp
      </a>
      <a class="btn btn-outline-brand btn-lg" href={site.listaPrecios} download>
        <i class="bi bi-file-earmark-arrow-down me-2"></i>Lista de precios (PDF)
      </a>
    </div>

    <ul class="list-unstyled text-secondary mb-0">
      <li class="mb-1"><i class="bi bi-geo-alt me-2 text-brand"></i>{site.zona}</li>
      <li class="mb-1"><i class="bi bi-clock me-2 text-brand"></i>{site.horario}</li>
      <li class="mb-1">
        <i class="bi bi-envelope me-2 text-brand"></i><a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <i class="bi bi-instagram me-2 text-brand"></i>
        <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
      </li>
    </ul>
  </div>
</section>
