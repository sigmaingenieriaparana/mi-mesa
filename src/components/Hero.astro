---
import { site, whatsappUrl } from '../config/site';
---

<header id="inicio" class="hero">
  <div class="container">
    <h1 class="display-4 fw-bold mb-3">{site.slogan}</h1>
    <p class="lead mb-4">{site.descripcion}</p>
    <div class="d-flex flex-wrap gap-3">
      <a class="btn btn-light btn-lg" href={site.listaPrecios} download>
        <i class="bi bi-file-earmark-arrow-down me-2"></i>Descargar lista de precios
      </a>
      <a class="btn btn-whatsapp btn-lg" href={whatsappUrl} target="_blank" rel="noopener">
        <i class="bi bi-whatsapp me-2"></i>Consultar por WhatsApp
      </a>
    </div>
  </div>
</header>
